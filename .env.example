# ---------------------------------------------------------------------------
# prerender - example configuration
# Every value below is the built-in default; the service starts with no .env
# file at all, except that ALLOWED_HOSTS is mandatory.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
PORT=8080
READ_TIMEOUT=15s
# Must exceed RENDER_TIMEOUT or slow renders get cut off mid-response.
WRITE_TIMEOUT=120s
IDLE_TIMEOUT=60s
# Validated at startup to be greater than RENDER_TIMEOUT.
SHUTDOWN_GRACE_PERIOD=60s

# --- security -------------------------------------------------------------
# Mandatory. Exact hostnames, comma separated, no wildcards.
# Without this the service would fetch and return any URL on the internet.
ALLOWED_HOSTS=example.com,www.example.com

# --- redis ----------------------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=prerender:html:
REDIS_TIMEOUT=2s
CACHE_TTL=6h
CACHE_ENABLED=true
# Writes a companion prerender:meta:<url> hash for operator visibility.
CACHE_META=true

# --- concurrency ----------------------------------------------------------
# Each concurrent render is roughly 50-150MB of Chromium.
# 2 core / 4GB -> 4;  4 core / 8GB -> 8.  Tune from observed RSS.
MAX_CONCURRENT_RENDERS=4
QUEUE_WAIT_TIMEOUT=30s

# --- browser --------------------------------------------------------------
# Leave empty to let chromedp auto-detect chrome/chromium on PATH.
CHROME_PATH=
# Hard ceiling for one render, including navigation and readiness polling.
RENDER_TIMEOUT=45s
# Must be less than RENDER_TIMEOUT. A navigation timeout is not fatal:
# the readiness loop still runs and the result is marked degraded.
NAVIGATION_TIMEOUT=20s

# Readiness ladder tuning.
MIN_WAIT_MS=300
MAX_WAIT_MS=8000
NETWORK_IDLE_MS=500
POLL_INTERVAL_MS=150
STABILITY_CHECKS=3

# Blocking images, fonts and analytics is the single biggest speedup available.
BLOCK_RESOURCES=true
# Replaces the built-in default list entirely when set (not merged with it) -
# so it starts from the same defaults below. Add unreachable third-party
# domains to the end as they're found (comma separated, "*" wildcards ok).
# BLOCKED_URL_PATTERNS=*.png,*.jpg,*.jpeg,*.gif,*.webp,*.avif,*.ico,*.bmp,*.svg,*.woff,*.woff2,*.ttf,*.otf,*.eot,*.mp4,*.webm,*.mp3,*.avi,*.mov,*google-analytics.com*,*googletagmanager.com*,*doubleclick.net*,*facebook.net*,*connect.facebook.com*,*hotjar.com*,*clarity.ms*,*newrelic.com*,*nr-data.net*

# Refuses to render matching URLs outright (403), before any cache lookup or
# browser work. Unlike BLOCKED_URL_PATTERNS this checks the target URL itself,
# not its subresources. Comma separated, "*" wildcards ok. Use for pages that
# should never be crawled/prerendered, e.g. content behind login.
# BLOCKED_PATH_PATTERNS=*/sso-page/*

# Chromium is restarted after this many renders to bound memory growth.
BROWSER_MAX_RENDERS=500
# Renders smaller than this are treated as failures and never cached.
MIN_HTML_BYTES=512

# --- logging --------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
